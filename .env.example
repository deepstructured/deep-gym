# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Telegram bot (OTP login) ─────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Bot username without @ (shown on the login screen)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=deepgym_bot
# Random secret used to validate webhook calls from Telegram.
# Generate one: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=random-secret-string

# ── App ──────────────────────────────────────────────────────────────────
# App origin for local/auth integrations. Keep localhost while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical public SEO origin; independent from local/auth URLs.
# Defaults to https://www.deepgym.fit (the production redirect destination).
# Never use a preview hostname.
NEXT_PUBLIC_SEO_URL=https://www.deepgym.fit
# Optional ownership tokens supplied by Google Search Console / Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
