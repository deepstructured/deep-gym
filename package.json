{
  "name": "deepgym",
  "version": "1.6.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "mobile": "npm run start -w @deepgym/mobile",
    "mobile:go": "npm run go -w @deepgym/mobile",
    "mobile:typecheck": "npm run typecheck -w @deepgym/mobile",
    "icons": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "avatars:legacy": "node scripts/generate-avatars.mjs",
    "secrets:check": "node scripts/check-publication.mjs --worktree",
    "secrets:staged": "node scripts/check-publication.mjs",
    "verify": "npm run typecheck && npm run mobile:typecheck && npm run icons:check",
    "precommit": "npm run verify && git diff --check && npm run secrets:check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.75.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.17",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sass": "^1.101.0",
    "zustand": "^5.0.4"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.8.3"
  }
}
